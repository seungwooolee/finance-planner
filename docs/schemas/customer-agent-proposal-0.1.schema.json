{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DION-AGENT-PROPOSAL-0.1",
  "description": "후속 개발용 LLM 의도·입력 후보 계약. 현재 API/DB에 연결하지 않은 문서 스키마이며 실행 권한이나 확인 사실을 부여하지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intent", "candidates", "clarification_code"],
  "properties": {
    "schema_version": {"const": "DION-AGENT-PROPOSAL-0.1"},
    "intent": {
      "enum": ["EXPLAIN_RESULT", "EXPLAIN_SCHEME", "CHECK_CONDITIONS", "PROPOSE_CHANGE", "CLARIFY", "UNSUPPORTED"]
    },
    "candidates": {
      "type": "array",
      "maxItems": 5,
      "items": {"$ref": "#/definitions/candidate"}
    },
    "clarification_code": {
      "enum": [null, "TARGET_NOT_RESOLVED", "PERIOD_NOT_RESOLVED", "MULTIPLE_INTENTS", "MEANING_NOT_RESOLVED", "OUTSIDE_SUPPORTED_FIELDS"]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"intent": {"enum": ["EXPLAIN_RESULT", "EXPLAIN_SCHEME", "CLARIFY", "UNSUPPORTED"]}}},
      "then": {"properties": {"candidates": {"maxItems": 0}}}
    }
  ],
  "definitions": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_ref", "operation", "source_text", "value"],
      "properties": {
        "field_ref": {
          "description": "현재 R2의 명시 레지스트리. 지원 필드 추가는 정의·엔진 바인딩·검증을 함께 버전 변경한 후 수행한다. 대상 불명확/미지원이면 null.",
          "enum": [
            null,
            "F03/monthly_net_income_krw",
            "F03/income_period_start",
            "F03/income_period_end",
            "F03/includes_one_off_income",
            "F04/living",
            "F04/expense_basis",
            "F04/included_debt",
            "F04/included_contributions",
            "F04/essential_living",
            "NEW-04/has_liabilities",
            "N01/owns_real_estate"
          ]
        },
        "operation": {"enum": ["OBSERVE", "SET", "INCREASE_BY", "DECREASE_BY"]},
        "source_text": {
          "description": "수신 발화에 실제 존재하는 원문 구간. 서버가 원문과 대조하며 실행 지시로 취급하지 않는다.",
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "value": {
          "oneOf": [
            {"$ref": "#/definitions/money"},
            {"$ref": "#/definitions/flag"},
            {"$ref": "#/definitions/text"},
            {"$ref": "#/definitions/date"},
            {"$ref": "#/definitions/missing"}
          ]
        }
      }
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "state", "raw_value", "unit"],
      "properties": {
        "kind": {"const": "MONEY"},
        "state": {"const": "KNOWN"},
        "raw_value": {"type": "string", "pattern": "^[0-9]{1,40}(?:\\.[0-9]{1,4})?$", "maxLength": 45},
        "unit": {"enum": ["KRW", "KRW_10000"]}
      }
    },
    "flag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "state", "raw_value", "unit"],
      "properties": {
        "kind": {"const": "BOOLEAN"},
        "state": {"const": "KNOWN"},
        "raw_value": {"type": "boolean"},
        "unit": {"const": "BOOLEAN"}
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "state", "raw_value", "unit"],
      "properties": {
        "kind": {"const": "TEXT"},
        "state": {"const": "KNOWN"},
        "raw_value": {"type": "string", "minLength": 1, "maxLength": 160},
        "unit": {"const": "TEXT"}
      }
    },
    "date": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "state", "raw_value", "unit"],
      "properties": {
        "kind": {"const": "DATE"},
        "state": {"const": "KNOWN"},
        "raw_value": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "unit": {"const": "DATE"}
      }
    },
    "missing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "state", "raw_value", "unit"],
      "properties": {
        "kind": {"const": "MISSING"},
        "state": {"enum": ["UNKNOWN", "NOT_ENTERED", "NOT_ASKED", "NOT_APPLICABLE", "DEFERRED", "DECLINED"]},
        "raw_value": {"type": "null"},
        "unit": {"type": "null"}
      }
    }
  }
}
