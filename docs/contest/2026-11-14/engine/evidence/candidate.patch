+def test_actual_zero_income_remains_a_deficit_not_missing():
+    doc = base_case()
+    raw(doc, "F03")["monthly_net_income"] = m(0)
+    result = run_engine(doc)
+    flow = result["results"]["OUT-03"]
+    assert flow["after_existing_contributions_krw"] == "-2500000"
+    assert flow["feasibility"] == "SHORTFALL"
+    assert result["input_snapshot"]["answers"] == doc["answers"]
+
