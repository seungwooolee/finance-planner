+"""SUBMISSION-B-01: literal/independent oracles, never golden current-engine output."""
+import copy
+import hashlib
+import json
+import os
+from fractions import Fraction
+from math import floor
+from pathlib import Path
+
+import pytest
+
+from app.planning.engine import run_engine
+from app.planning.proposal_reference import build
+from app.planning.question_v12 import run_question_v12
+from tests.planning.cases import base_case, m, put, raw
+
+EVIDENCE = Path(__file__).resolve().parents[3] / "docs/contest/2026-11-14/engine/evidence"
+
+
+@pytest.fixture(scope="module", params=["initial", "revised", "partial"])
+def replay(request):
+    capture = json.loads((EVIDENCE / f"{request.param}-input.json").read_text(encoding="utf-8"))
+    original = copy.deepcopy(capture)
+    result = run_engine(capture["engine_input"])
+    assert capture == original
+    # Opt-in evidence output for the one scoped verification run; no DB or API.
+    if os.environ.get("DION_CONTEST_WRITE_EVIDENCE") == "1":
+        (EVIDENCE / f"{request.param}-current-result.json").write_text(
+            json.dumps(result, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
+        )
+    return request.param, capture, result
+
+
+def test_submission_assets_reservations_and_goal_dates(replay):
+    _, capture, result = replay
+    assert result["input_snapshot"] == capture["engine_input"]
+    assert result["context"]["evaluation_on"] == "2026-11-30"
+    assets = result["results"]["OUT-02"]
+    assert assets["total_assets"]["value"] == "20000000"
+    assert assets["total_debt"]["value"] == "0"
+    assert assets["net_worth"]["value"] == "20000000"
+    # 20m cash = protection 6m + operating 2m + education 2m + free 10m.
+    reserves = next(a["raw_response"] for a in capture["engine_input"]["answers"]
+                    if a["question_id"] == "NEW-06")
+    assert [Fraction(r["amount"]["value"]) * 10000 for r in reserves["items"]] == [6000000, 2000000, 2000000]
+    goal = result["results"]["OUT-04"]["rows"][0]
+    assert (goal["target_krw"], goal["prepared_krw"], goal["gap_krw"]) == ("5000000", "2000000", "3000000")
+    assert goal["due_on"] == "2027-02-28"
+    assert goal["funding_schedule"] == [
+        {"on": day, "amount_krw": "1000000"} for day in ["2026-12-15", "2027-01-15", "2027-02-15"]
+    ]
+    assert goal["level_contribution_krw"] == "1000000"  # (5m - 2m) / 3
+
+
+def test_submission_monthly_conservation_and_no_implicit_recommendation(replay):
+    variant, capture, result = replay
+    flow = result["results"]["OUT-03"]
+    plans = result["results"]["OUT-05"]
+    if variant == "partial":
+        assert flow["base_surplus"]["value"] is None
+        assert plans["calc_state"] == "NEEDS_INPUT"
+        assert not plans.get("candidates")
+        income = next(a["raw_response"]["monthly_net_income"] for a in capture["engine_input"]["answers"]
+                      if a["question_id"] == "F03")
+        raw = next(a["envelope"]["fields"]["payload"]["raw_value"]["monthly_net_income"]
+                   for a in capture["raw_answers"]["answers"] if a["envelope"]["question_ref"]["design_id"] == "F03")
+        assert raw["state"] == "NOT_ENTERED" and raw["value"] is None
+        assert income["state"] == "UNKNOWN" and income["value"] is None
+        return
+    income = 5000000 if variant == "initial" else 5200000
+    residual = income - 2000000 - 500000 - 1000000
+    assert flow["after_existing_contributions_krw"] == str(income - 2500000)
+    assert [p["strategy_id"] for p in plans["candidates"]] == ["STABILITY_FIRST", "INVESTMENT_CAPACITY"]
+    for candidate, ratio in zip(plans["candidates"], [Fraction(1, 2), Fraction(4, 5)], strict=True):
+        investment = int(residual * ratio)
+        cash = 20000000
+        assert len(candidate["rows"]) == 3
+        for index, row in enumerate(candidate["rows"]):
+            goal_payment = 5000000 if index == 2 else 0
+            cash += income - 2000000 - 500000 - investment - goal_payment
+            assert row["period"] == ["2026-12", "2027-01", "2027-02"][index]
+            assert row["new_investment_krw"] == str(investment)
+            assert row["additional_cash_krw"] == str(residual - investment)
+            assert row["kept_noncash_krw"] == "500000"
+            assert row["goal_deposits_krw"] == "1000000"
+            assert row["goal_paid_krw"] == str(goal_payment)
+            assert row["closing_cash_krw"] == str(cash)
+            assert row["goals"][0]["closing_cash_krw"] == ["3000000", "4000000", "0"][index]
+            assert row["cash_difference_krw"] == "0"
+            assert row["recommended_new_investment_krw"] is None
+        # Contributions remain assets. Only living and education are consumed.
+        assert candidate["final_net_worth_krw"] == str(20000000 + 3 * income - 6000000 - 5000000)
+        assert candidate["final_cash_krw"] == str(cash)
+    assert result["results"]["OUT-06"]["calc_state"] == "NOT_SUPPORTED"
+
