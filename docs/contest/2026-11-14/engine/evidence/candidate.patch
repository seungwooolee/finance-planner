+@pytest.mark.parametrize("months", [0, 35, 36])
+def test_reference_goal_zero_and_short_term_boundary(months):
+    goal = {"goal_id": "boundary", "calc_state": "CALCULATED", "target_krw": "0", "prepared_krw": "0",
+            "contribution_count": months, "level_contribution_krw": "0", "due_on": "2030-12-31"}
+    result = build({"results": {"OUT-04": {"calc_state": "CALCULATED", "rows": [goal]}}})
+    row = result["goals"][0]
+    assert row["assumed_return_monthly_krw"] == ("0" if months == 36 else None)
+    assert row["assumed_return_reason"] == (None if months == 36 else "SHORT_TERM_GOAL_NO_RETURN")
+    assert row["delay_monthly_krw"] == "0"
+
