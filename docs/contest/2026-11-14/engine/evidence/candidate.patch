+@pytest.mark.parametrize("months", [36, 60, 120])
+@pytest.mark.parametrize("monthly", ["0", "300000", "750000", "1200000"])
+def test_reference_exact_fraction_accumulation_and_inflation(months, monthly):
+    original = {"results": {"OUT-05": {"calc_state": "CALCULATED", "candidates": [{
+        "strategy_id": "STABILITY_FIRST", "rows": [{"period": "2026-12", "new_investment_krw": monthly,
+                                                     "living_krw": "2000000"}]
+    }]}}}
+    before = copy.deepcopy(original)
+    result = build(original)
+    point = next(p for p in result["plans"][0]["points"] if p["months"] == months)
+    # Sum each month-end deposit's exact growth independently of production annuity helper.
+    accumulated = sum(Fraction(int(monthly)) * Fraction(301, 300) ** n for n in range(months))
+    assert point["assumed_return_krw"] == str(floor(accumulated))
+    assert point["assumed_return_real_krw"] == str(floor(accumulated / Fraction(51, 50) ** (months // 12)))
+    assert point["zero_return_krw"] == str(int(monthly) * months)
+    assert original == before
+    assert result["reference_only"] is True
+
