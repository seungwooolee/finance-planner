+def test_legacy_submission_payload_is_not_current_question_adapter(replay):
+    _, capture, _ = replay
+    document = {
+        "schema_version": "DION-QUESTION12-ADAPTER-1.1",
+        "context": capture["engine_input"]["context"],
+        "scope_ref": "household",
+        "raw_bundle": capture["raw_answers"],
+        "confirmations": [],
+        "requested_outputs": capture["engine_input"]["requested_outputs"],
+    }
+    result = run_question_v12(document)
+    # No assertion of automatic migration: preserved 1.3-engine payloads aren't 1.2/1.2.1 fields.
+    assert result["calc_state"] != "CALCULATED"
+
