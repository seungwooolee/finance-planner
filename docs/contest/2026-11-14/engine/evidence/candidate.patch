+@pytest.mark.parametrize("kind", ["RENTAL_DEPOSIT", "REAL_ESTATE"])
+def test_non_cash_assets_never_create_current_goal_or_investment_cash(kind):
+    doc = base_case()
+    asset = copy.deepcopy(raw(doc, "F06")["items"][0])
+    asset.update(asset_id="illiquid-1", kind=kind, value=m(50000000), available_on="2028-01-31",
+                 withdrawal_constraint="LOCKED")
+    put(doc, "NEW-09" if kind == "RENTAL_DEPOSIT" else "F08", {"items": [asset]})
+    result = run_engine(doc)
+    assert result["results"]["OUT-02"]["net_worth"]["value"] == "70000000"
+    a, b = result["results"]["OUT-05"]["candidates"]
+    assert [a["final_cash_krw"], b["final_cash_krw"]] == ["20250000", "18900000"]
+    assert a["rows"][0]["new_investment_krw"] == "750000"
+    # Merely recording availability does not sell property or receive the deposit.
+    assert all(r["event_in_krw"] == "0" for r in a["rows"])
+
