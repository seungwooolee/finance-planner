+@pytest.mark.parametrize("kind", ["multiple_per_month", "skipped_month", "early_payment"])
+def test_dated_goal_is_not_relabelled_as_equal_monthly_reference(kind):
+    doc = base_case()
+    if kind == "multiple_per_month":
+        raw(doc, "F12")["items"][0]["contribution_dates"] = ["2027-01-01", "2027-01-10", "2027-01-15"]
+    elif kind == "skipped_month":
+        raw(doc, "F12")["items"][0]["contribution_dates"] = ["2027-01-15", "2027-03-15"]
+    else:
+        payment = raw(doc, "F13")["items"][0]["payments"][0]
+        payment["amount"] = m(4000000)
+        raw(doc, "F13")["items"][0]["payments"].append(
+            {"on": "2027-01-20", "amount": m(1000000), "economic_event_id": "early"}
+        )
+    result = run_engine(doc)
+    assert result["results"]["OUT-04"]["calc_state"] == "CALCULATED"
+    before = copy.deepcopy(result)
+    reference = build(result)
+    assert reference["goals"] == []
+    assert reference["goal_omissions"] == [{"goal_id": "goal-1", "reason": "MONTHLY_REFERENCE_CALENDAR_UNSUPPORTED"}]
+    assert result == before
