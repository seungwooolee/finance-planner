+def test_frozen_manifest_and_canonical_case():
+    manifest = json.loads((EVIDENCE / "lead-manifest.json").read_text(encoding="utf-8"))
+    path = EVIDENCE.parents[4] / manifest["case"]["canonical_input_path"]
+    assert hashlib.sha256(path.read_bytes()).hexdigest() == manifest["case"]["canonical_input_sha256"]
+    doc = json.loads(path.read_text(encoding="utf-8"))
+    result = run_engine(doc)
+    assert result["results"]["OUT-02"]["net_worth"]["value"] == "20000000"
+    a, b = result["results"]["OUT-05"]["candidates"]
+    assert [a["final_cash_krw"], b["final_cash_krw"]] == ["20250000", "18900000"]
+    assert [a["final_net_worth_krw"], b["final_net_worth_krw"]] == ["24000000", "24000000"]
+    reference = build(result)
+    assert reference["goal_omissions"] == []
+    assert reference["goals"][0]["months"] == 3
+    if os.environ.get("DION_CONTEST_WRITE_EVIDENCE") == "1":
+        (EVIDENCE / "canonical-current-result.json").write_text(
+            json.dumps({"engine": result, "proposal_reference": reference}, ensure_ascii=False, indent=2) + "\n",
+            encoding="utf-8",
+        )
+
