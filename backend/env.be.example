# Copy only these additional names into your existing backend/.env.
# Never overwrite the user's existing .env or put real values in this template.
DION_DB_HOST=your-session-pooler-host
DION_DB_PORT=5432
DION_DB_NAME=postgres
DION_DB_USER=postgres.your-project-ref
DION_DB_PASSWORD=REPLACE_LOCALLY
DION_SUPABASE_URL=https://your-project-ref.supabase.co
DION_SUPABASE_PUBLIC_KEY=REPLACE_WITH_PUBLISHABLE_OR_ANON_KEY

# mock (default), deterministic, or oneport. All live gates default to off.
DION_EXPLANATION_PROVIDER=mock

# OnePort R1-c. Use the issued exact chat model; never put this key in NEXT_PUBLIC_*.
# Invalid/missing configuration returns the existing deterministic explanation.
DION_ONEPORT_ENABLED=false
DION_ONEPORT_BASE_URL=https://schoolorder.kr/v1
DION_ONEPORT_API_KEY=
DION_ONEPORT_MODEL=gpt-6.1-terra
DION_ONEPORT_TIMEOUT_SECONDS=15
DION_ONEPORT_CONNECT_TIMEOUT_SECONDS=3
DION_ONEPORT_MAX_OUTPUT_TOKENS=4096
DION_ONEPORT_MAX_REQUEST_BYTES=131072
DION_ONEPORT_MAX_RESPONSE_BYTES=131072
# Persistent local disk shared by ALL workers on ONE host; not an ephemeral disk.
DION_ONEPORT_LEDGER_PATH=artifacts/oneport-receipts.sqlite3
# Live calls stay blocked until you confirm the path above is persistent and shared by ALL
# workers (set true only then). Ephemeral hosts (e.g. redeploy wipes disk) must keep false.
DION_ONEPORT_LEDGER_PERSISTENT=false
# Explicit user-approved credits, not KRW/USD. Unknown settlement keeps reservation.
# Reserve must cover the published full-context/highest-tier cost ceiling.
# A dedicated gateway key spending cap is an additional operational protection.
# This session approved KRW 70,000 = 35,000 credits (official 2 KRW/credit).
# The live synthetic probe used reserve=3000, max_calls=1, max_output_tokens=2048.
# Keep defaults below disabled; an expired approval must not renew automatically.
DION_ONEPORT_BUDGET_SCOPE=
DION_ONEPORT_BUDGET_CREDITS=0
DION_ONEPORT_RESERVE_CREDITS=0
DION_ONEPORT_MAX_CALLS=1
# Zoned ISO time on the SAME Korean calendar day, before the daily limit resets.
DION_ONEPORT_EXPIRES_AT=
# R1-c live permission is synthetic data only. Customer data needs separate opt-in.
DION_ONEPORT_ALLOW_SAVED_RESULTS=false
